# Moly 环境变量模板
# 复制为 .env（服务端 Express 读取）和 .env.local（前端 Vite 读取），填入真实值。
# ⚠️ 切勿提交真实密钥到 git！.env 与 .env.local 已在 .gitignore 中。

# ============================================================
# 服务端 (Express, 读取 .env / process.env)
# ============================================================
# Supabase —— service_role 密钥，仅服务端使用，绝不可暴露到前端
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# 可选：服务端兜底密钥（正常由前端请求头传入，可留空）
# KLING_API_KEY=
# GEMINI_BASE_URL=https://www.ezmodel.cloud

# ── TTS 配音（MiniMax 海螺）──
# 在 MiniMax 开放平台获取：API Key 与 GroupId
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_GROUP_ID=your-minimax-group-id
# 国际站 https://api.minimaxi.chat ；国内站 https://api.minimax.chat
MINIMAX_BASE_URL=https://api.minimaxi.chat
TTS_PROVIDER=minimax

# ── TTS 配音（火山引擎 语音合成大模型 BigTTS，可选）──
# 在火山语音技术控制台开通「语音合成大模型」后获取 APPID 与 Access Token（新版大模型，非旧版 BV 音色）
# VOLC_TTS_APPID=your-volc-appid
# VOLC_TTS_TOKEN=your-volc-access-token

# ── 找爆款：Apify 抓取（TikTok/Amazon 爆款）──
# 在 Apify 后台 https://console.apify.com/account/integrations 获取 API token
# APIFY_TOKEN=apify_api_xxx

# ── 可选：FFmpeg 二进制路径覆盖（不设则自动用系统 ffmpeg 或 ffmpeg-static）──
# FFMPEG_PATH=
# FFPROBE_PATH=

# 可选：邮件通道（未配置则验证码在接口响应中以 devCode 返回，便于本地开发）
# BREVO_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM_NAME=Moly
# EMAIL_FROM_ADDR=moly@example.com
# APP_BASE_URL=http://localhost:5173

# ============================================================
# 前端 (Vite, 读取 .env.local —— 注意：VITE_ 变量会被打包进客户端 JS，浏览器可见)
# ⚠️ 不要在此放高敏感密钥；Kling 密钥建议后续改由服务端签名，不要下发到前端
# ============================================================
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_ANALYSIS_MODEL=gemini-3.1-flash-image-preview
VITE_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
VITE_GEMINI_BASE_URL=https://www.ezmodel.cloud
VITE_KLING_ACCESS_KEY=your-kling-access-key
VITE_KLING_SECRET_KEY=your-kling-secret-key
