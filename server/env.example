# 认证服务环境变量（复制为 .env 或写入部署平台环境配置）
# 启动时加载方式示例: AUTH_PORT=3002 node server/index.js
# 或在项目根目录 .env 中配置后由 pm2/docker 等注入

# ---------- 服务端口 ----------
# AUTH_PORT=3002

# ---------- 邮件验证码（SMTP） ----------
# 配置后，邮箱验证码会真实发送；不配置则仅在接口响应中返回 devCode（仅开发用）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-sender@example.com
SMTP_PASS=your-smtp-password
# SMTP_FROM=your-sender@example.com

# 常见邮箱 SMTP 示例：
# 网易 163: SMTP_HOST=smtp.163.com  SMTP_PORT=465  SMTP_USER=你的163邮箱  SMTP_PASS=授权码
# QQ 邮箱:  SMTP_HOST=smtp.qq.com   SMTP_PORT=465  SMTP_USER=你的qq邮箱   SMTP_PASS=授权码
# 企业微信: 使用企业邮箱 SMTP 或自建邮箱服务

# ---------- 短信验证码 ----------
# 方式一：使用 Webhook（推荐，可对接任意短信服务商）
# 本服务会向该 URL 发起 POST，body: { phone, countryCode, code, text }
# 你可在自己的后端或云函数里接收后调用阿里云/腾讯云/Twilio 等 API 发短信
SMS_WEBHOOK_URL=https://your-api.com/send-sms
# SMS_WEBHOOK_AUTH=Bearer your-secret

# 方式二：直接对接某一家短信商需在 server/index.js 中扩展 sendSms()，
# 并配置该服务商的 Key/Secret 等环境变量（见下方说明）

# 国内常用短信服务商配置示例（需在代码中接入对应 SDK 后使用）：
# 阿里云: 开通「短信服务」- 申请签名与模板 - 使用 AccessKey 调用 SendSms
# 腾讯云: 开通「短信」- 申请签名与正文模板 - 使用 SecretId/SecretKey 调用
# 其他: Twilio、华为云、七牛等均有 HTTP API，可统一用 SMS_WEBHOOK_URL 转发

# ── 公测开关与支付（聚合支付·虎皮椒 xunhupay.com，个人开发者可用） ──
# 开放注册(默认开)。设为 false 回到内测白名单
OPEN_REGISTRATION=true
# 新用户赠送积分(默认 100)
FREE_CREDITS=100
# 虎皮椒：微信通道 appid/secret（虎皮椒后台「微信支付」处获取）
HUPI_WECHAT_APPID=
HUPI_WECHAT_SECRET=
# 虎皮椒：支付宝通道 appid/secret（后台「支付宝」处获取，与微信是两对密钥）
HUPI_ALIPAY_APPID=
HUPI_ALIPAY_SECRET=
# 回调域名(默认生产域名)；虎皮椒会 POST {APP_BASE_URL}/api/pay/notify/{channel}
# APP_BASE_URL=https://moly-production-2f51.up.railway.app

# ── 微信支付·官方 V3 Native(最稳：办个体户→腾讯直结到你的银行卡，无中间商) ──
# pay.weixin.qq.com 商户进件后获得。配齐后「微信」通道自动优先走官方(支付宝仍走下方 XorPay/虎皮椒)。
# 回调 {APP_BASE_URL}/api/pay/notify-wxpay。私钥(apiclient_key.pem 全文)换行用 \n 转义成单行。
WXPAY_APPID=
WXPAY_MCHID=
WXPAY_API_V3_KEY=
WXPAY_CERT_SERIAL=
WXPAY_PRIVATE_KEY=

# ── XorPay(免营业执照的聚合通道，灰色地带、有资金/证件风险，仅作过渡备用) xorpay.com ──
# 一对 aid/secret 通吃微信(native扫码)+支付宝(当面付，需在 XorPay 后台开通)
# 回调 {APP_BASE_URL}/api/pay/notify-xorpay
XORPAY_AID=
XORPAY_SECRET=

# ── 验证码通道(公测必配,否则邮箱注册返回"服务配置中") ──
# 邮箱三选一:BREVO_API_KEY / RESEND_API_KEY / SMTP_USER+SMTP_PASS(默认 smtp.qq.com,QQ邮箱授权码)
# 发件人(Brevo/Resend 用):EMAIL_FROM_NAME / EMAIL_FROM_ADDR
# ALLOW_DEV_CODE=true 仅限本地开发——把验证码回显在接口响应里,生产环境绝不能设!

# ── Google 一键登录(GIS)。Google Cloud Console → 凭据 → OAuth 客户端ID(Web应用)
# 已授权的 JavaScript 来源填 https://moly.video 和 https://www.moly.video；不填则登录页不显示 Google 按钮
GOOGLE_CLIENT_ID=

# ── 超级管理员(给任意用户充值积分) ──
# ADMIN_EMAILS: 逗号分隔，决定谁能看到「管理」入口(默认 chenxianquan2023@gmail.com)
# ADMIN_SECRET: 充值硬密钥；不设=管理充值功能整体关闭(安全默认)
ADMIN_EMAILS=
ADMIN_SECRET=
